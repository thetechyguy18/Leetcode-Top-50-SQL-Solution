SELECT DEPARTMENT, EMPLOYEE , SALARY FROM (SELECT 
    D.NAME AS DEPARTMENT, 
    E.NAME AS EMPLOYEE, 
    E.SALARY, 
    DENSE_RANK() OVER (PARTITION BY D.NAME ORDER BY E.SALARY DESC) AS RN
FROM 
    EMPLOYEE E
JOIN 
    DEPARTMENT D 
ON 
    E.DEPARTMENTID = D.ID
ORDER BY 
    D.NAME, E.SALARY DESC) A 
    WHERE A.RN IN (1,2,3);
