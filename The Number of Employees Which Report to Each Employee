with temp as (select reports_to id, count(reports_to) cnt,Round(Avg(age)) avg_age from Employees
group by reports_to)

select E.employee_id, E.name,temp.cnt as reports_count,
 temp.avg_age average_age from employees E 
join temp on temp.id = E.employee_id
order by e.employee_id;
