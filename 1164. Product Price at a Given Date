https://leetcode.com/problems/product-price-at-a-given-date/description/?envType=study-plan-v2&envId=top-sql-50

WITH TEMP AS (SELECT P.PRODUCT_ID, P.NEW_PRICE FROM (select product_id, max(change_date) dt from Products
where change_date <= to_date('2019-08-16','YYYY-MM-DD')
group by product_id) A 
JOIN PRODUCTS P ON P.PRODUCT_ID = A.PRODUCT_ID AND P.CHANGE_DATE = A.DT) 

SELECT DISTINCT PA.PRODUCT_ID , 
CASE WHEN TEMP.NEW_PRICE IS NULL THEN 10 
ELSE TEMP.NEW_PRICE END AS PRICE FROM PRODUCTS PA 
LEFT JOIN TEMP ON PA.PRODUCT_ID = TEMP.PRODUCT_ID
 
