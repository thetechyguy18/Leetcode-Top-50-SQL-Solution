/* Write your PL/SQL query statement below */
WITH TEMP AS (SELECT PERSON_NAME, SUM(WEIGHT) OVER (ORDER BY TURN ) 
COM_W, TURN FROM QUEUE)

SELECT PERSON_NAME
FROM TEMP 
WHERE COM_W <=1000 AND TURN = (
    SELECT MAX(TURN) FROM TEMP 
    WHERE COM_W <= 1000
)

WITH TEMP AS (SELECT PERSON_NAME, SUM(WEIGHT) OVER (ORDER BY TURN ) 
COM_W FROM QUEUE),

RANKED AS (SELECT PERSON_NAME,ROW_NUMBER() OVER (ORDER BY COM_W DESC) RN 
FROM TEMP 
WHERE COM_W <=1000)
SELECT PERSON_NAME FROM RANKED
WHERE RN=1;
