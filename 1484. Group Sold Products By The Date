/* Write your PL/SQL query statement below */
with temp as (select distinct to_char(sell_date) sell_date, product from Activities)

select sell_date,
regexp_count(listagg(product,',') within group (order by sell_date desc),',')+1 num_sold,
listagg(product,',') within group (order by sell_date desc) products
 from temp
group by sell_date
order by sell_date
