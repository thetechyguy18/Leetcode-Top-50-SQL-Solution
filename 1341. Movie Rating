with USR AS  (select user_id from (select user_id, count(user_id),
dense_rank() over (order by count(user_id) desc ) as rn from MovieRating
group by user_id) A
where A.rn = 1),

 MOWIE AS (SELECT MOVIE_ID FROM (SELECT MOVIE_ID, AVG(RATING), 
Dense_rank() over (order by AVG(RATING) desc ) as rn 
 FROM MOVIERATING
WHERE CREATED_AT BETWEEN TO_DATE('01-02-2020','DD-MM-YYYY') AND 
TO_DATE('29-02-2020','DD-MM-YYYY')
GROUP BY MOVIE_ID) B 
WHERE B.RN =1)

SELECT MIN(USERS.NAME) AS RESULTS FROM USERS 
JOIN USR ON USR.USER_ID = USERS.USER_ID

UNION ALL 

SELECT MIN(M.TITLE) AS RESULTS FROM MOVIES M 
JOIN MOWIE B ON M.MOVIE_ID = B.MOVIE_ID


