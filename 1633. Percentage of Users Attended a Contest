--SELECT COUNT (DISTINCT USER_ID) CNT FROM USERS

SELECT R.CONTEST_ID, 
ROUND((COUNT(R.CONTEST_ID)/
(SELECT COUNT (DISTINCT USER_ID) CNT FROM USERS))
*100,2) AS percentage  FROM USERS U 
 JOIN REGISTER R ON R.USER_ID = U.USER_ID
GROUP BY R.CONTEST_ID
ORDER BY ROUND((COUNT(R.CONTEST_ID)/
(SELECT COUNT (DISTINCT USER_ID) CNT FROM USERS))
*100,2) DESC, R.CONTEST_ID ;

